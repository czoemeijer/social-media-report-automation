# Self-hosted Dify base URL. Do not include /console/api or /openapi/v1.
DIFY_BASE_URL=https://dify.example.com
DIFY_WORKSPACE_ID=

# Account-scoped Dify OpenAPI OAuth bearer (Dify 1.17.1 operations).
DIFY_OPENAPI_TOKEN=

# Console session credentials for administrative operations such as plugin
# installation and draft workflow execution. These are not OpenAPI tokens.
DIFY_CONSOLE_ACCESS_TOKEN=
DIFY_CSRF_TOKEN=

# Optional deployment-only binding. The repository DSL remains unbound.
DIFY_MODEL_PROVIDER=
DIFY_MODEL_NAME=

# Meta Graph / Instagram / Marketing API. Use only credentials for assets you
# are authorized to read. All selectors are optional for `meta discover`.
META_GRAPH_VERSION=v26.0
META_AUTH_MODE=user_token
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_BUSINESS_ID=
META_PAGE_ID=
META_IG_USER_ID=
META_AD_ACCOUNT_ID=
META_TIMEOUT_SECONDS=20
META_MAX_RETRIES=3
