{
  "$id": "https://social-report.local/schemas/input_manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "files": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "manifest": {
      "items": {
        "properties": {
          "filename": {
            "type": "string"
          },
          "mime_type": {
            "type": "string"
          },
          "perceptual_hash": {
            "type": [
              "string",
              "null"
            ]
          },
          "relative_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "size": {
            "minimum": 1,
            "type": "integer"
          },
          "source_id": {
            "type": "string"
          },
          "transport_name": {
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "filename",
          "mime_type",
          "sha256",
          "size"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "files",
    "manifest"
  ],
  "title": "Campaign input manifest",
  "type": "object"
}
